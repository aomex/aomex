{
  "name": "aomex",
  "private": true,
  "repository": "git@github.com:aomex/aomex.git",
  "homepage": "https://aomex.js.org",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "vitest",
    "build": "node scripts/remove-dist.mjs && pnpm --recursive --workspace-concurrency 1 prepublishOnly",
    "prepare": "husky",
    "deploy:main": "sh scripts/develop-deploy-main.sh",
    "sync:main": "sh scripts/develop-sync-main.sh"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.0.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.14.0",
  "dependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "@typescript/typescript6": "^6.0.2",
    "@vitest/coverage-v8": "^5.1.0",
    "husky": "^9.1.7",
    "lerna": "^10.1.1",
    "prettier": "^3.10.1",
    "read-package-up": "^12.0.0",
    "redis-memory-server": "^0.17.2",
    "sleep-promise": "^9.1.0",
    "supertest": "^7.3.2",
    "ts-expect": "^1.3.0",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^7.3.0",
    "vitest": "^5.1.0"
  }
}
