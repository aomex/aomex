{
  "name": "@aomex/console",
  "version": "4.1.0",
  "description": "控制台应用",
  "scripts": {
    "prepublishOnly": "tsdown && node ./scripts/version-shim.mjs"
  },
  "type": "module",
  "types": "src/index.ts",
  "exports": "./src/index.ts",
  "publishConfig": {
    "types": "dist/index.d.ts",
    "bin": {
      "aomex": "bin.mjs"
    },
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "files": [
    "dist",
    "bin.mjs",
    "LICENSE",
    "package.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "keywords": [],
  "repository": "git@github.com:aomex/aomex.git",
  "homepage": "https://aomex.js.org",
  "license": "MIT",
  "peerDependencies": {
    "@aomex/common": "^4.0.0",
    "@aomex/logger": "^4.0.0"
  },
  "dependencies": {
    "@aomex/internal-file-import": "workspace:*",
    "@aomex/internal-tools": "workspace:*",
    "ansi-escapes": "^7.3.0",
    "glob": "^14.0.6",
    "is-unicode-supported": "^2.1.0",
    "log-symbols": "^7.0.1",
    "log-update": "^8.0.0",
    "table": "^6.10.1",
    "tsx": "^4.23.15",
    "yargs": "^18.2.0",
    "yargs-parser": "^22.0.0"
  },
  "devDependencies": {
    "@aomex/common": "workspace:*",
    "@aomex/logger": "workspace:*",
    "@types/yargs": "^17.0.35",
    "@types/yargs-parser": "^21.0.3"
  }
}
