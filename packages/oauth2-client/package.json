{
  "name": "@aomex/oauth2-client",
  "version": "4.6.0",
  "description": "OAuth 2.0 / OIDC 授权码客户端（PKCE）",
  "repository": "git@github.com:aomex/aomex.git",
  "homepage": "https://aomex.js.org",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "prepublishOnly": "tsdown"
  },
  "types": "src/index.ts",
  "exports": "./src/index.ts",
  "files": [
    "dist",
    "LICENSE",
    "package.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "peerDependencies": {
    "@aomex/cache": "^4.0.0",
    "@aomex/common": "^4.0.0",
    "@aomex/web": "^4.0.0"
  },
  "dependencies": {
    "jose": "^6.2.0",
    "oidc-token-hash": "^5.2.0"
  },
  "devDependencies": {
    "@aomex/cache": "workspace:*",
    "@aomex/common": "workspace:*",
    "@aomex/web": "workspace:*"
  }
}
