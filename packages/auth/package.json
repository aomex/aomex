{
  "name": "@aomex/auth",
  "version": "3.30.7",
  "description": "身份认证统一入口",
  "scripts": {
    "prepublishOnly": "tsdown"
  },
  "type": "module",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./bearer": "./src/strategies/auth-bearer-strategy.ts",
    "./api-key": "./src/strategies/auth-api-key-strategy.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./bearer": {
        "types": "./dist/strategies/auth-bearer-strategy.d.ts",
        "import": "./dist/strategies/auth-bearer-strategy.js"
      },
      "./api-key": {
        "types": "./dist/strategies/auth-api-key-strategy.d.ts",
        "import": "./dist/strategies/auth-api-key-strategy.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "files": [
    "dist",
    "LICENSE",
    "package.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "repository": "git@github.com:aomex/aomex.git",
  "homepage": "https://aomex.js.org",
  "license": "MIT",
  "peerDependencies": {
    "@aomex/common": "^4.0.0",
    "@aomex/web": "^4.0.0"
  },
  "devDependencies": {
    "@aomex/common": "workspace:^",
    "@aomex/web": "workspace:^"
  }
}
