{
  "name": "@aomex/rate-limit",
  "version": "4.4.0",
  "description": "请求限速",
  "repository": "git@github.com:aomex/aomex.git",
  "homepage": "https://aomex.js.org",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/websocket.js"
  ],
  "scripts": {
    "prepublishOnly": "tsdown"
  },
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./memory": "./src/memory-store.ts",
    "./websocket": "./src/websocket.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "package.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./memory": {
        "types": "./dist/memory-store.d.ts",
        "import": "./dist/memory-store.js"
      },
      "./websocket": {
        "types": "./dist/websocket.d.ts",
        "import": "./dist/websocket.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "peerDependencies": {
    "@aomex/common": "^4.0.0",
    "@aomex/web": "^4.0.0",
    "@aomex/websocket": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@aomex/websocket": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aomex/common": "workspace:*",
    "@aomex/web": "workspace:*",
    "@aomex/websocket": "workspace:*"
  }
}
