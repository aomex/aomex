{
  "name": "@aomex/cache",
  "version": "4.3.0",
  "description": "缓存基础类",
  "scripts": {
    "prepublishOnly": "tsdown"
  },
  "type": "module",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./file": "./src/adapters/cache-file-adapter.ts",
    "./memory": "./src/adapters/cache-memory-adapter.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./file": {
        "types": "./dist/adapters/cache-file-adapter.d.ts",
        "import": "./dist/adapters/cache-file-adapter.js"
      },
      "./memory": {
        "types": "./dist/adapters/cache-memory-adapter.d.ts",
        "import": "./dist/adapters/cache-memory-adapter.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "files": [
    "dist",
    "LICENSE",
    "package.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "repository": "git@github.com:aomex/aomex.git",
  "homepage": "https://aomex.js.org",
  "license": "MIT",
  "peerDependencies": {
    "@aomex/common": "^4.0.0"
  },
  "dependencies": {
    "@aomex/async-trace": "workspace:*"
  },
  "devDependencies": {
    "@aomex/common": "workspace:*"
  }
}
