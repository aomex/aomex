{
  "name": "@aomex/kafka",
  "version": "4.8.0",
  "description": "类型安全的 Kafka 生产与消费",
  "repository": "git@github.com:aomex/aomex.git",
  "homepage": "https://aomex.js.org",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/override/kafka-middleware.js"
  ],
  "scripts": {
    "prepublishOnly": "tsdown"
  },
  "types": "src/index.ts",
  "exports": "./src/index.ts",
  "files": [
    "dist",
    "package.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "peerDependencies": {
    "@aomex/common": "^4.0.0",
    "@aomex/logger": "^4.0.0"
  },
  "dependencies": {
    "@aomex/internal-file-import": "workspace:*",
    "@aomex/internal-tools": "workspace:*",
    "@confluentinc/kafka-javascript": "^1.11.0"
  },
  "devDependencies": {
    "@aomex/common": "workspace:*",
    "@aomex/logger": "workspace:*"
  }
}
